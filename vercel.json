{
    "version": 2,
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/next"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/"
      }
    ],
    "crons": [
      {
        "path": "/api/reset-daily-slp",
        "schedule": "0 16 * * *"
      }
    ],
    "env": {
      "TZ": "Asia/Manila"
    }
  }
  
  